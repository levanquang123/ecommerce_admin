{
  "outputDirectory": "build/web",
  "routes": [
    {
      "src": "/flutter_service_worker.js",
      "headers": { "Cache-Control": "no-cache" },
      "continue": true
    },
    {
      "src": "/main.dart.js",
      "headers": { "Cache-Control": "no-cache" },
      "continue": true
    },
    {
      "src": "/flutter_bootstrap.js",
      "headers": { "Cache-Control": "no-cache" },
      "continue": true
    },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
